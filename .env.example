# envisia-forge environment configuration
# Copy this file to .env and adjust values for your environment.
# For local development, docker-compose.yml provides Postgres and versitygw.
#
# IMPORTANT: the server reads config via figment with `Env::prefixed("FORGE_").split("__")`,
# so every nested key uses a DOUBLE underscore (`__`) between sections, e.g.
# `FORGE_SERVER__BIND` -> server.bind, `FORGE_AUTH__BOOTSTRAP_ADMIN__USERNAME` ->
# auth.bootstrap_admin.username. A single underscore is treated as part of one
# key name and is silently ignored. See crates/server/src/config.rs and
# forge.toml.example for the equivalent TOML layout.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
FORGE_DATABASE__URL=postgres://forge:forge@localhost:5432/forge
# Alias read directly (not via figment); cargo sqlx and some tooling use it.
DATABASE_URL=postgres://forge:forge@localhost:5432/forge

# SQLX_OFFLINE=true is used for normal builds so cargo check/build
# does not require a live database. Run `cargo sqlx prepare` after
# changing query macros to regenerate the .sqlx/ cached metadata.
SQLX_OFFLINE=true

# ---------------------------------------------------------------------------
# S3 / Object storage
# For local dev: versitygw runs on localhost:7070 (see docker-compose.yml)
# For production: point at your real S3-compatible endpoint
# ---------------------------------------------------------------------------
FORGE_S3__ENDPOINT=http://localhost:7070
FORGE_S3__REGION=us-east-1
FORGE_S3__BUCKET=forge
FORGE_S3__ACCESS_KEY=minioadmin
FORGE_S3__SECRET_KEY=minioadmin
# Force path-style addressing (required for versitygw and MinIO; leave false for AWS S3)
FORGE_S3__FORCE_PATH_STYLE=true
# Multipart upload threshold in bytes (default 8 MiB)
FORGE_S3__MULTIPART_THRESHOLD=8388608

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
FORGE_SERVER__BIND=0.0.0.0:3000
# Public base URL used to build absolute NuGet V3 service-index @id values.
# Must NOT have a trailing slash.
FORGE_SERVER__PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Authentication
# anonymous_mode: off | allowlist | all
# ---------------------------------------------------------------------------
FORGE_AUTH__ANONYMOUS_MODE=off
# List of CIDRs or tokens (loopback, private, local, or CIDR notation). figment
# parses list values from the bracket form `[a,b]` (NOT bare comma-separated).
FORGE_AUTH__ANONYMOUS_IP_ALLOWLIST=[loopback]
# List of CIDRs of trusted reverse proxies (used for X-Forwarded-For). Same
# bracket-form list syntax; leave as an empty list to trust none.
FORGE_AUTH__TRUSTED_PROXY_CIDRS=[]
# Allow HTTP Basic with the user password (in addition to tokens). Off by default.
FORGE_AUTH__ALLOW_PASSWORD_BASIC=false
# Bootstrap admin created on first run if no admin users exist. Both the username
# and password keys nest under auth.bootstrap_admin (note the extra `__`).
FORGE_AUTH__BOOTSTRAP_ADMIN__USERNAME=admin
FORGE_AUTH__BOOTSTRAP_ADMIN__PASSWORD=changeme

# ---------------------------------------------------------------------------
# Credential-forwarding authentication (slice 12.3 — optional)
# Ordered password-style provider chain + an upstream-basic provider that
# validates a login by forwarding username/password to a configured upstream
# over HTTP Basic (the verdaccio-nexus-auth-proxy pattern). The default chain is
# just `[local-password]`; add `upstream-basic` to enable forwarding.
# ---------------------------------------------------------------------------
# FORGE_AUTH__PROVIDERS=[local-password,upstream-basic]
# Upstream endpoint hit with the user's Basic credentials (must be http/https;
# use https in production — the password rides the outbound Basic header).
# FORGE_AUTH__UPSTREAM_BASIC__URL=https://nexus.internal/service/rest/v1/status
# FORGE_AUTH__UPSTREAM_BASIC__METHOD=GET
# FORGE_AUTH__UPSTREAM_BASIC__SUCCESS_STATUS=[200]
# FORGE_AUTH__UPSTREAM_BASIC__REJECT_STATUS=[401,403]
# FORGE_AUTH__UPSTREAM_BASIC__CONNECT_TIMEOUT_MS=2000
# FORGE_AUTH__UPSTREAM_BASIC__REQUEST_TIMEOUT_MS=5000
# Allow the upstream URL to resolve to a private/loopback address (internal
# Nexus). Off blocks them via the SSRF guard.
# FORGE_AUTH__UPSTREAM_BASIC__ALLOW_PRIVATE_UPSTREAM=true
# Auto-provision a passwordless app_user on first successful upstream login.
# FORGE_AUTH__UPSTREAM_BASIC__AUTO_PROVISION=true
# Optional coarse allow-gate parsed from the JSON body (groups_path is required
# when required_groups is set); optional admin-group mapping (grant-only).
# FORGE_AUTH__UPSTREAM_BASIC__GROUPS_PATH=user.roles
# FORGE_AUTH__UPSTREAM_BASIC__REQUIRED_GROUPS=[nuget-users]
# FORGE_AUTH__UPSTREAM_BASIC__ADMIN_GROUP=nx-admin
# Validated-credential cache: positive/negative TTLs (seconds) + the SECRET
# pepper that keys the cache HMAC (redacted everywhere; never the password).
# FORGE_AUTH__UPSTREAM_BASIC__CACHE__POSITIVE_TTL_SECS=300
# FORGE_AUTH__UPSTREAM_BASIC__CACHE__NEGATIVE_TTL_SECS=30
# FORGE_AUTH__UPSTREAM_BASIC__CACHE__KEY_PEPPER=change-me-to-a-high-entropy-secret

# ---------------------------------------------------------------------------
# Redis (optional — omit or leave blank to disable; L1 moka cache only)
# When set, Redis is used as a shared L2 cache and invalidation backplane
# enabling efficient cross-instance cache coherence.
# ---------------------------------------------------------------------------
# FORGE_REDIS__URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
FORGE_CACHE__L1_MAX_CAPACITY=10000
# Default TTL in seconds for cached entries (applies when Redis L2 is absent)
FORGE_CACHE__DEFAULT_TTL_SECONDS=30

# ---------------------------------------------------------------------------
# Outbox worker (blob GC transactional outbox)
# ---------------------------------------------------------------------------
FORGE_OUTBOX__BATCH_SIZE=100
# Grace period in seconds before a pending S3 delete fires
FORGE_OUTBOX__GRACE_SECONDS=3600
# How often the outbox worker polls for due rows (seconds)
FORGE_OUTBOX__POLL_INTERVAL_SECONDS=10

# ---------------------------------------------------------------------------
# Retention worker (policy-driven cleanup; drives blob GC via the outbox)
# ---------------------------------------------------------------------------
# Run the background retention worker on this instance. When false, the admin
# REST surface (policy config, preview, run-now) still works; due repositories
# wait for an instance that runs the worker.
FORGE_RETENTION__ENABLED=true
# How often each instance polls for a due repository (seconds)
FORGE_RETENTION__POLL_INTERVAL_SECONDS=30
# Default floor between automatic runs per repo (seconds); a larger per-repo
# min_run_interval_seconds in the policy wins
FORGE_RETENTION__DEFAULT_RUN_INTERVAL_SECONDS=3600
# Crash-safe lease held while a repo is being evaluated (seconds)
FORGE_RETENTION__LEASE_SECONDS=300

# ---------------------------------------------------------------------------
# Static web UI (SPA) serving
# ---------------------------------------------------------------------------
# Serve the built TanStack Start SPA from the Rust server (single origin).
FORGE_WEB__ENABLED=true
# Directory holding the built SPA (index.html + assets/). Defaults to web/dist.
FORGE_WEB__ASSETS_DIR=web/dist

# ---------------------------------------------------------------------------
# OpenID Connect / Microsoft Entra interactive login (optional — slice 12.2)
# Set FORGE_OIDC__* to enable browser login (authorization-code + PKCE). All
# flow state and sessions live in Postgres, so any instance can complete a
# callback another instance started. Leave unset to disable (no /auth/oidc/*).
# The client_secret is redacted from logs and admin API output.
# ---------------------------------------------------------------------------
# FORGE_OIDC__ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# FORGE_OIDC__CLIENT_ID=00000000-0000-0000-0000-000000000000
# FORGE_OIDC__CLIENT_SECRET=<application-client-secret>
# Must match public_base_url host + this exact path.
# FORGE_OIDC__REDIRECT_URL=http://localhost:3000/auth/oidc/callback
# Bracket-form list; openid is always added implicitly if missing.
# FORGE_OIDC__SCOPES=[openid,profile,email]
# FORGE_OIDC__CLOCK_SKEW_SECONDS=60
# Claim → user mapping (fallback chain: username_claim -> email -> sub).
# FORGE_OIDC__USERNAME_CLAIM=preferred_username
# FORGE_OIDC__EMAIL_CLAIM=email
# FORGE_OIDC__DISPLAY_NAME_CLAIM=name
# Provisioning.
# FORGE_OIDC__AUTO_PROVISION=true
# FORGE_OIDC__LINK_EXISTING_BY_USERNAME=true
# Admin assignment — empty admin_groups means OIDC never grants admin.
# FORGE_OIDC__ADMIN_GROUPS=[forge-admins]
# FORGE_OIDC__ADMIN_CLAIM=roles
# Session lifecycle (idle timeout / absolute lifetime, seconds).
# FORGE_OIDC__SESSION_IDLE_TTL_SECONDS=28800
# FORGE_OIDC__SESSION_ABSOLUTE_TTL_SECONDS=604800
