# Copy to forge.env (git-ignored) and fill in. Becomes the forge-env Secret;
# every FORGE_* key here overrides the image's baked config. One KEY=value per
# line, no quotes. See docs/deployment.md for each setting.

FORGE_DATABASE__URL=postgres://forge:<password>@postgres.example.internal:5432/forge
FORGE_S3__ACCESS_KEY=<access key>
FORGE_S3__SECRET_KEY=<secret key>

# The in-cluster Redis (components/redis). URL-safe: `openssl rand -hex 24`.
REDIS_PASSWORD=<redis password>

# Secret encryption at rest. Generate once (`openssl rand -base64 32`) and keep
# it with your backups: without it stored upstream passwords and realm
# secrets cannot be recovered.
FORGE_CRYPTO__ROOT__PROVIDER=env
FORGE_ROOT_KEY=<base64 32 bytes>

# First start only: creates the bootstrap admin. Remove it once real admins
# exist.
FORGE_AUTH__BOOTSTRAP_ADMIN__PASSWORD=<initial admin password>
