# Copy to forge.env (git-ignored) and fill in. Becomes the forge-env Secret.
# One KEY=value per line, no quotes. Forge refuses the dev placeholders
# (`minioadmin` S3 keys, a `changeme` admin password) and the `<…>` ones below.

# The in-cluster PostgreSQL (components/postgres). URL-safe: `openssl rand -hex 24`.
POSTGRES_PASSWORD=<postgres password>

# Root credentials of the in-cluster S3 gateway (components/s3-versitygw),
# which Forge uses too.
FORGE_S3__ACCESS_KEY=<access key>
FORGE_S3__SECRET_KEY=<secret key>

# First start only: creates the bootstrap admin, named by a UPN.
FORGE_AUTH__BOOTSTRAP_ADMIN__USERNAME=admin@example.com
FORGE_AUTH__BOOTSTRAP_ADMIN__PASSWORD=<initial admin password>
