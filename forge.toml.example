# envisia-forge configuration (TOML form).
#
# Copy this to `forge.toml` (loaded automatically if present in the working
# directory) or point $FORGE_CONFIG at it (the file must then exist: a missing
# $FORGE_CONFIG file fails startup). This file is the base layer; any
# `FORGE_*` environment variable overrides the matching key (see .env.example).
# Nested keys map section-by-section: `[auth].bootstrap_admin.username` is set
# via `FORGE_AUTH__BOOTSTRAP_ADMIN__USERNAME`.
#
# Keys marked "(default: …)" may be omitted entirely.

[server]
bind = "0.0.0.0:8421"
# Public base URL for absolute NuGet V3 service-index @id values. No trailing slash.
public_base_url = "http://localhost:8421"
# The placeholder credentials in this example (minioadmin S3 keys, bootstrap
# admin/changeme) are refused at startup unless this is true. Keep it for a
# local dev copy only; in production replace the placeholders and drop it.
allow_insecure_defaults = true  # (default: false)
# Largest accepted `dotnet nuget push` body. Uploads stream to a temp file
# (never buffered in memory); larger pushes get HTTP 413.
max_upload_bytes = 536870912    # (default: 512 MiB)
# Host names (port ignored) clients reach this server under besides the host of
# public_base_url, e.g. the name a reverse proxy rewrites Host to. Only gates
# anonymous_mode = "allowlist": a request naming any other host is not served
# anonymously by IP (DNS-rebinding guard).
allowed_hosts = []              # (default: [])
# Connection and request time limits. A client that takes longer to send its
# request headers, or whose request body stalls longer, is cut off; a handler
# that has not answered within request_timeout_seconds gets 408 (an already
# streaming download is not cut off). Keep request_timeout_seconds above the
# slowest push of max_upload_bytes you expect. header_read_timeout_seconds also
# closes an idle keep-alive connection: keep it above your reverse proxy's
# upstream keep-alive idle timeout, or the proxy may reuse a connection Forge is
# closing and answer 502. 0 disables a limit.
header_read_timeout_seconds = 150 # (default: 150)
body_idle_timeout_seconds = 60   # (default: 60)
request_timeout_seconds = 900    # (default: 900)

[database]
url = "postgres://forge:forge@localhost:5432/forge"
max_connections = 20            # (default: 20) connection-pool size
acquire_timeout_seconds = 10    # (default: 10) wait for a free connection before failing

[s3]
endpoint = "http://localhost:8422"
region = "us-east-1"            # (default: "us-east-1")
bucket = "forge"
access_key = "minioadmin"
secret_key = "minioadmin"
force_path_style = true         # (default: true) required for versitygw/MinIO
multipart_threshold = 8388608   # (default: 8 MiB) switch to multipart above this many bytes
# Dedup PUTs with `If-None-Match: *` instead of HEAD-then-PUT: auto | on | off.
# "auto" tries the conditional PUT and falls back to HEAD-then-PUT for the
# process lifetime if the backend rejects it (versitygw); "on" forces it (AWS
# S3/MinIO); "off" disables it. Pure optimization — behavior is identical.
conditional_writes = "auto"     # (default: "auto")

[auth]
anonymous_mode = "off"          # (default: "off") off | allowlist | all
# Tokens (loopback/private/local) or CIDRs; used only when anonymous_mode = "allowlist".
anonymous_ip_allowlist = ["loopback"]   # (default: [])
# CIDRs of reverse proxies whose X-Forwarded-For is trusted.
trusted_proxy_cidrs = []        # (default: [])
allow_password_basic = false    # (default: false)
# Password-failure lockout per (client IP, username) for /auth/login and Basic
# password auth; 0 disables.
login_max_failures = 10             # (default: 10)
login_failure_window_seconds = 300  # (default: 300)
# Most argon2 password verifications running at once (~19 MiB and a core each);
# more queue for a few seconds, then fail as unavailable (not counted as a
# failed password). 0 = the number of available CPUs.
password_verify_concurrency = 0     # (default: 0)
# 12.7 login UX: "identifier_first" (ask username, then route to a password
# prompt or an OIDC redirect) or "combined" (always show username+password +
# a button per enabled OIDC realm).
login_mode = "identifier_first" # (default: "identifier_first")
# Browser-session lifetimes (apply to local-password AND OIDC logins). When
# unset, falls back to the legacy oidc.session_* keys, then 8h / 7d.
# session_idle_ttl_seconds     = 28800
# session_absolute_ttl_seconds = 604800
# How long an instance trusts its cached snapshot of the auth_realm table.
realm_cache_ttl_seconds = 10    # (default: 10)
# Concurrent upstream credential forwards (verdict-cache misses) allowed per
# credential-forwarding realm, per instance; excess logins fail closed (401).
credential_forward_max_concurrent = 32  # (default: 32)

# Optional: bootstrap admin, created once on the first start with a password.
# Omit the section, or leave the password empty/unset, for no bootstrap admin
# (remove the password once real admins exist). "changeme" is refused unless
# server.allow_insecure_defaults = true.
[auth.bootstrap_admin]
username = "admin"              # (default: "admin")
password = "changeme"

[redis]
# Optional shared L2 cache + invalidation backplane. Omit (or leave the url
# blank) for L1-only caching.
# url = "redis://localhost:6379"
# A slower/partitioned Redis is treated as a cache miss instead of hanging reads.
# connect_timeout_ms  = 2000    # (default: 2000)
# response_timeout_ms = 2000    # (default: 2000)

[proxy]
# Outbound HTTP to proxy upstreams (nuget.org, Azure Artifacts, GitHub
# Packages, Artifactory, Nexus, ProGet, …). Upstream credentials configured on
# a proxy repository are sent with every request to the remote_url host
# (service index, version listing, .nuspec and .nupkg).
connect_timeout_seconds  = 15          # (default: 15)
read_timeout_seconds     = 60          # (default: 60) max silence between two reads
metadata_timeout_seconds = 60          # (default: 60) total, per metadata request
download_timeout_seconds = 1800        # (default: 1800) total, per .nupkg download
max_metadata_bytes       = 33554432    # (default: 32 MiB)
max_package_bytes        = 1073741824  # (default: 1 GiB)
# Metadata bodies up to this size stay in memory; larger ones spill to a
# temp file that is removed when the request ends. Packages always stream
# to a temp file.
spool_memory_bytes       = 2097152     # (default: 2 MiB)

[nuget]
# .nupkg archive safety limits for published and proxied packages. Only the
# .nuspec manifest is ever decompressed, so it alone is capped by size and
# compression ratio; other entries (large native binaries included) are only
# bounded by the archive-shape limits below.
max_entries                  = 10000        # (default: 10000)
max_central_directory_bytes  = 16777216     # (default: 16 MiB) zip directory loaded to open a package
max_total_uncompressed_bytes = 17179869184  # (default: 16 GiB) total declared size of all entries
max_nuspec_bytes             = 1048576      # (default: 1 MiB) also caps an upstream .nuspec a proxy verifies
max_nuspec_compression_ratio = 200          # (default: 200)

[cache]
l1_max_capacity = 10000         # (default: 10000)
default_ttl_seconds = 30        # (default: 30)

[outbox]
batch_size = 100                # (default: 100)
grace_seconds = 3600            # (default: 3600) grace before a dereferenced blob is deleted
poll_interval_seconds = 10      # (default: 10)
processed_retention_seconds = 604800  # (default: 604800 = 7 days) keep processed outbox rows this long; 0 = never prune

# Optional: OpenID Connect / Microsoft Entra interactive login (slice 12.2).
# 12.7: this block is a one-shot SEED — on first boot it is imported into an
# `auth_realm` row and authentication is managed in the admin UI from then on
# (the block is ignored afterwards; the same applies to [auth.upstream_basic]).
# All flow state and sessions live in Postgres, so any instance can complete a
# callback another instance started. The client_secret is redacted from logs
# and admin API output.
# [oidc]
# enabled        = true                                                        # (default: true)
# issuer         = "https://login.microsoftonline.com/<tenant-id>/v2.0"        # must be https
# client_id      = "00000000-0000-0000-0000-000000000000"
# client_secret  = "<application-client-secret>"                               # redacted from APIs/logs
# redirect_url   = "http://localhost:8421/auth/oidc/callback"                  # must match public_base_url host + this path
# scopes         = ["openid", "profile", "email"]                              # (default) openid is always added
# clock_skew_seconds = 60                                                      # (default: 60) exp/nbf/iat leeway
# # claim → user mapping (fallback chain: username_claim → email → sub)
# username_claim     = "preferred_username"  # (default)
# email_claim        = "email"               # (default)
# display_name_claim = "name"                # (default)
# # provisioning
# auto_provision             = true          # (default) create app_user on first login
# link_existing_by_username  = false         # (default) opt-in; never links password accounts or admins
# # admin assignment — empty admin_groups means OIDC never grants admin (safe default)
# admin_groups = ["forge-admins"]            # group/role values that grant is_admin
# admin_claim  = "roles"                     # (default) claim matched against admin_groups ("roles" or "groups")
# # session lifecycle
# session_idle_ttl_seconds     = 28800       # (default: 8h) idle timeout
# session_absolute_ttl_seconds = 604800      # (default: 7d) absolute lifetime
