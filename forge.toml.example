# envisia-forge configuration (TOML form).
#
# Copy this to `forge.toml` (loaded automatically if present in the working
# directory) or point $FORGE_CONFIG at it. This file is the base layer; any
# `FORGE_*` environment variable overrides the matching key (see .env.example).
# Nested keys map section-by-section: `[auth].bootstrap_admin.username` is set
# via `FORGE_AUTH__BOOTSTRAP_ADMIN__USERNAME`.
#
# Keys marked "(default: …)" may be omitted entirely.

[server]
bind = "0.0.0.0:8421"
# Public base URL for absolute NuGet V3 service-index @id values. No trailing slash.
public_base_url = "http://localhost:8421"

[database]
url = "postgres://forge:forge@localhost:5432/forge"

[s3]
endpoint = "http://localhost:8422"
region = "us-east-1"            # (default: "us-east-1")
bucket = "forge"
access_key = "minioadmin"
secret_key = "minioadmin"
force_path_style = true         # (default: true) required for versitygw/MinIO
multipart_threshold = 8388608   # (default: 8 MiB) switch to multipart above this many bytes
# Dedup PUTs with `If-None-Match: *` instead of HEAD-then-PUT: auto | on | off.
# "auto" tries the conditional PUT and falls back to HEAD-then-PUT for the
# process lifetime if the backend rejects it (versitygw); "on" forces it (AWS
# S3/MinIO); "off" disables it. Pure optimization — behavior is identical.
conditional_writes = "auto"     # (default: "auto")

[auth]
anonymous_mode = "off"          # (default: "off") off | allowlist | all
# Tokens (loopback/private/local) or CIDRs; used only when anonymous_mode = "allowlist".
anonymous_ip_allowlist = ["loopback"]   # (default: [])
# CIDRs of reverse proxies whose X-Forwarded-For is trusted.
trusted_proxy_cidrs = []        # (default: [])
allow_password_basic = false    # (default: false)

# Optional: bootstrap admin created on first run if no admin users exist.
# Omit the whole section to skip.
[auth.bootstrap_admin]
username = "admin"
password = "changeme"

[redis]
# Optional shared L2 cache + invalidation backplane. Omit for L1-only caching.
# url = "redis://localhost:6379"

[cache]
l1_max_capacity = 10000         # (default: 10000)
default_ttl_seconds = 30        # (default: 30)

[outbox]
batch_size = 100                # (default: 100)
grace_seconds = 3600            # (default: 3600) grace before a dereferenced blob is deleted
poll_interval_seconds = 10      # (default: 10)

# Optional: OpenID Connect / Microsoft Entra interactive login (slice 12.2).
# Omit the whole [oidc] section to disable login (no /auth/oidc/* routes).
# All flow state and sessions live in Postgres, so any instance can complete a
# callback another instance started. The client_secret is redacted from logs
# and admin API output.
# [oidc]
# enabled        = true                                                        # (default: true)
# issuer         = "https://login.microsoftonline.com/<tenant-id>/v2.0"        # must be https
# client_id      = "00000000-0000-0000-0000-000000000000"
# client_secret  = "<application-client-secret>"                               # redacted from APIs/logs
# redirect_url   = "http://localhost:8421/auth/oidc/callback"                  # must match public_base_url host + this path
# scopes         = ["openid", "profile", "email"]                              # (default) openid is always added
# clock_skew_seconds = 60                                                      # (default: 60) exp/nbf/iat leeway
# # claim → user mapping (fallback chain: username_claim → email → sub)
# username_claim     = "preferred_username"  # (default)
# email_claim        = "email"               # (default)
# display_name_claim = "name"                # (default)
# # provisioning
# auto_provision             = true          # (default) create app_user on first login
# link_existing_by_username  = true          # (default) link matching local user (bootstrap-admin interplay)
# # admin assignment — empty admin_groups means OIDC never grants admin (safe default)
# admin_groups = ["forge-admins"]            # group/role values that grant is_admin
# admin_claim  = "roles"                     # (default) claim matched against admin_groups ("roles" or "groups")
# # session lifecycle
# session_idle_ttl_seconds     = 28800       # (default: 8h) idle timeout
# session_absolute_ttl_seconds = 604800      # (default: 7d) absolute lifetime
