  "query": "\n        UPDATE content_selector\n        SET description = COALESCE($2, description),\n            includes    = COALESCE($3, includes),\n            excludes    = COALESCE($4, excludes),\n            updated_at  = now()\n        WHERE id = $1\n        RETURNING id, name, description, includes, excludes\n        ",
