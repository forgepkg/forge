  "query": "\n        SELECT b.s3_key, b.size\n        FROM oci_blob_link l\n        JOIN blob b ON b.sha256 = l.blob_sha256\n        WHERE l.blob_sha256 = $1 AND l.repository_id = $2 AND b.state = 'committed'\n        LIMIT 1\n        ",
