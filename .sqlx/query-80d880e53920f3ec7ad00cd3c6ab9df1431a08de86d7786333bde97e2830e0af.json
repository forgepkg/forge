{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id, user_id, external_identity_id, token_hash, csrf_secret,\n            user_agent_hash, created_at, last_seen_at, idle_expiry,\n            absolute_expiry, revoked_at\n        FROM session\n        WHERE token_hash = $1\n          AND revoked_at IS NULL\n          AND now() < idle_expiry\n          AND now() < absolute_expiry\n        ",
