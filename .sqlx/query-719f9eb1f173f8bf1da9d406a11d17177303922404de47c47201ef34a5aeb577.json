  "query": "\n        SELECT p.seq, p.start_offset, p.size, p.blob_sha256, p.sha512_base64, b.s3_key\n        FROM oci_upload_part p\n        JOIN blob b ON b.sha256 = p.blob_sha256\n        WHERE p.upload_id = $1\n        ORDER BY p.seq\n        ",
