  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id, username, password_hash, active,\n            auth_source, external_subject, kind, created_at, updated_at\n        FROM app_user\n        WHERE username = $1\n          AND auth_source = 'upstream-basic'\n          AND NOT realm_orphaned\n          AND realm_id IS NOT DISTINCT FROM $2::bigint\n        ",
