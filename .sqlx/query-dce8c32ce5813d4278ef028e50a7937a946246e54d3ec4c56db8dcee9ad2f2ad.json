  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, path, blob_sha256, updated_at, last_downloaded_at\n        FROM raw_file\n        WHERE repository_id = $1 AND path >= $2 AND ($3::text IS NULL OR path < $3)\n          AND strpos(substr(path, $4), '/') = 0\n        ORDER BY path\n        FOR UPDATE\n        ",
