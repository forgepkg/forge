  "db_name": "PostgreSQL",
  "query": "\n        UPDATE app_user\n        SET is_admin = $2,\n            updated_at = CASE WHEN is_admin <> $2 THEN now() ELSE updated_at END\n        WHERE id = $1\n        RETURNING\n            id, username, password_hash, is_admin, active,\n            auth_source, external_subject, created_at, updated_at\n        ",
