  "query": "\n        SELECT\n            r.id,\n            (SELECT count(*) FROM repository_privilege rp WHERE rp.role_id = r.id) AS \"grants!\",\n            (SELECT count(*) FROM user_role ur WHERE ur.role_id = r.id) AS \"users!\"\n        FROM role r\n        WHERE $1::bigint IS NULL OR r.id = $1\n        ",
