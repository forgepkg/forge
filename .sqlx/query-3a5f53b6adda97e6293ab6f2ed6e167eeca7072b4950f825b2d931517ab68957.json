{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            u.id, u.username, u.password_hash, u.is_admin, u.active,\n            u.auth_source, u.external_subject, u.created_at, u.updated_at\n        FROM app_user u\n        JOIN external_identity ei ON ei.user_id = u.id\n        WHERE ei.issuer = $1 AND ei.subject = $2\n        ",
