  "db_name": "PostgreSQL",
  "query": "\n        UPDATE repository SET\n            name = $2,\n            anonymous_read = $3,\n            online = $4,\n            config = $5,\n            remote_url = $6,\n            package_delay_seconds = $7,\n            upstream_username = $8,\n            metadata_ttl_seconds = $9,\n            not_found_ttl_seconds = $10,\n            allow_redeploy = $11,\n            upstream_password_enc = CASE WHEN $12 THEN NULL ELSE upstream_password_enc END,\n            updated_at = now()\n        WHERE id = $1\n        RETURNING\n            id, name, format, kind, anonymous_read, online, config,\n            remote_url, package_delay_seconds, upstream_username, upstream_password_enc,\n            metadata_ttl_seconds, not_found_ttl_seconds,\n            allow_redeploy, created_at, updated_at\n        ",
