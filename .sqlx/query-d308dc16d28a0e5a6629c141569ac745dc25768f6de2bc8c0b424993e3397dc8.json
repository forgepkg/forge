{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, client_id, scope, status, user_id, interval_seconds,\n               expires_at <= now() AS \"expired!\",\n               COALESCE(\n                   last_polled_at > now() - make_interval(secs => interval_seconds),\n                   false\n               ) AS \"too_fast!\"\n        FROM device_authorization\n        WHERE device_code_hash = $1\n        FOR UPDATE\n        ",
