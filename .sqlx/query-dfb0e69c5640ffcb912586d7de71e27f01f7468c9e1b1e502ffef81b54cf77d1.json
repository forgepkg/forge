{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT l.digest, l.blob_sha256, l.size, b.s3_key, l.last_used_at\n        FROM oci_blob_link l\n        JOIN blob b ON b.sha256 = l.blob_sha256\n        WHERE l.repository_id = $1 AND l.image = $2 AND l.digest = $3\n          AND b.state = 'committed'\n        ",
