{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.name AS \"name!\", COALESCE(SUM(a.download_count), 0)::bigint AS \"total!\"\n        FROM component c\n        JOIN asset a ON a.component_id = c.id AND a.path = 'package.nupkg'\n        WHERE c.repository_id = $1 AND c.name = ANY($2)\n        GROUP BY c.name\n        ",
