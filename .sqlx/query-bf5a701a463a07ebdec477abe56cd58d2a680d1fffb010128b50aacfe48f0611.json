  "query": "\n        SELECT\n            rp.level             AS level,\n            rp.repository_id     AS repository_id,\n            cs.id                AS \"selector_id?\",\n            cs.includes          AS \"includes?\",\n            cs.excludes          AS \"excludes?\"\n        FROM role r\n        JOIN repository_privilege rp ON rp.role_id = r.id\n        LEFT JOIN content_selector cs ON cs.id = rp.selector_id\n        WHERE r.name = $1\n        ",
