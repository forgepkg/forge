  "query": "\n        UPDATE auth_realm SET\n            name = $2,\n            enabled = $3,\n            priority = $4,\n            config = $5,\n            secrets_enc = $6,\n            updated_at = now()\n        WHERE id = $1\n          AND updated_at = $7\n          AND config = $8\n          AND secrets_enc IS NOT DISTINCT FROM $9\n        RETURNING id, kind, name, enabled, priority, config, secrets_enc, created_at, updated_at\n        ",
