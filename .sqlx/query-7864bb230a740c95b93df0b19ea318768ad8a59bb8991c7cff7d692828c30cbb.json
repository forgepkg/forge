  "query": "\n        SELECT\n            id, username, password_hash, is_admin, active,\n            auth_source, external_subject, created_at, updated_at\n        FROM app_user\n        WHERE username = $1\n          AND auth_source = 'upstream-basic'\n          AND ($2::bigint IS NULL OR realm_id IS NULL OR realm_id = $2)\n        ",
