{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT b.sha256, b.size, b.s3_key, b.ref_count, b.state, b.created_at\n        FROM blob b\n        WHERE b.ref_count = 0\n          AND b.created_at < $1\n          AND NOT EXISTS (\n              SELECT 1 FROM blob_outbox o\n              WHERE o.sha256 = b.sha256 AND o.processed_at IS NULL\n          )\n        ORDER BY b.created_at\n        LIMIT $2\n        ",
