{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE blob b\n        SET ref_count = b.ref_count - r.n\n        FROM (\n            SELECT sha256, count(*) AS n\n            FROM unnest($1::text[]) AS sha256\n            GROUP BY sha256\n        ) r\n        WHERE b.sha256 = r.sha256\n        RETURNING b.sha256, b.ref_count, b.s3_key\n        ",
