{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.image,\n               count(DISTINCT t.tag) AS \"tag_count!\",\n               count(DISTINCT m.id) AS \"manifest_count!\",\n               max(m.created_at) AS \"last_pushed_at!\"\n        FROM oci_manifest m\n        LEFT JOIN oci_tag t ON t.manifest_id = m.id\n        WHERE m.repository_id = $1 AND strpos(m.image, $2) > 0\n        GROUP BY m.image\n        ORDER BY m.image\n        OFFSET $3 LIMIT $4\n        ",
