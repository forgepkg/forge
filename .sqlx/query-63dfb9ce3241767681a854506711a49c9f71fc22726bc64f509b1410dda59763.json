  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.image, t.tag, t.manifest_id, m.digest, t.updated_at, m.last_pulled_at\n        FROM oci_tag t\n        JOIN oci_manifest m ON m.id = t.manifest_id\n        WHERE t.repository_id = $1\n        ORDER BY t.image, t.tag\n        ",
