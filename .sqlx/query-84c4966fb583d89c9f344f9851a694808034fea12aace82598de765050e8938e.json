  "query": "\n        SELECT\n            rp.level             AS \"level!\",\n            rp.repository_id     AS repository_id,\n            cs.id                AS \"selector_id?\",\n            cs.includes          AS \"includes?\",\n            cs.excludes          AS \"excludes?\"\n        FROM repository_privilege rp\n        LEFT JOIN content_selector cs ON cs.id = rp.selector_id\n        WHERE rp.role_id = $1\n        ",
